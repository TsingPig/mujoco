<?xml version='1.0' encoding='UTF-8'?>
<!-- Minimal hand-written pendulum seed for smoke demo. Replace with curated official seeds later. --><mujoco model="pendulum">
  <option gravity="0 0 -9.81" timestep="0.01" integrator="RK4"/>
  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.9 0.8 1"/>
    <body name="pole" pos="0 0 1.5">
      <joint name="hinge" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.1"/>
      <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 -1" size="0.05" mass="1.0"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="torque" joint="hinge" ctrlrange="-2 2"/>
  </actuator>
</mujoco>