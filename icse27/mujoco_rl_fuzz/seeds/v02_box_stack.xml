      <freejoint/>
      <geom name="g1" type="box" size="0.1 0.1 0.1" mass="1.0" rgba="0.7 0.2 0.2 1"/>
    </body>
    <body name="b2" pos="0.02 0 0.4">
      <freejoint/>
      <geom name="g2" type="box" size="0.08 0.08 0.08" mass="0.6" rgba="0.2 0.7 0.2 1"/>
    </body>
    <body name="b3" pos="-0.01 0.01 0.6">
      <freejoint/>
      <geom name="g3" type="box" size="0.06 0.06 0.06" mass="0.3" rgba="0.2 0.2 0.7 1"/>
    </body>
    <body name="ball" pos="0.5 0 0.2">
      <freejoint/>
      <geom name="gs" type="sphere" size="0.07" mass="0.4"/>
    </body>
  </worldbody>
</mujoco>