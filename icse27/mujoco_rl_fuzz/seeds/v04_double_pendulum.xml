<!-- Double pendulum: multi-joint chain. Stresses STRUCT_SHRINK / STRUCT_REWIRE / JOINT_PERTURB. -->
<mujoco model="double_pendulum">
  <option gravity="0 0 -9.81" timestep="0.005" integrator="implicitfast"/>
  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.9 0.8 1"/>
    <body name="link1" pos="0 0 2">
      <joint name="hinge1" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.05"/>
      <geom name="g1" type="capsule" fromto="0 0 0 0 0 -0.6" size="0.04" mass="0.8"/>
      <body name="link2" pos="0 0 -0.6">
        <joint name="hinge2" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.05"/>
        <geom name="g2" type="capsule" fromto="0 0 0 0 0 -0.6" size="0.04" mass="0.5"/>
        <body name="link3" pos="0 0 -0.6">
          <joint name="hinge3" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.05"/>
          <geom name="g3" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.03" mass="0.3"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="t1" joint="hinge1" ctrlrange="-3 3"/>
    <motor name="t2" joint="hinge2" ctrlrange="-2 2"/>
    <motor name="t3" joint="hinge3" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
